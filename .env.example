# --- Serveur ---
# Port HTTP (API + WebSocket + front statique en production)
MAESTRO_PORT=4520
# Répertoire de données (base SQLite, workspaces des agents, skills, token)
# Défaut : ~/.maestro
# MAESTRO_DATA_DIR=/home/user/.maestro
# Jeton d'authentification de l'interface. S'il est absent, un jeton est généré
# au premier démarrage et affiché dans les logs (persisté dans <dataDir>/token).
# MAESTRO_TOKEN=change-me
# Origines autorisées en CORS, séparées par des virgules. Par défaut : le port du
# serveur et le port de dev Vite, en localhost et 127.0.0.1. À renseigner
# uniquement si l'interface est servie depuis une autre origine.
# MAESTRO_ALLOWED_ORIGINS=https://maestro.exemple.fr

# --- Passerelle MCP (clients tiers : Codex, OpenCode, Goose…) ---
# Lues par le pont stdio `packages/server/bin/maestro-mcp.mjs`, pas par le serveur.
# MAESTRO_URL=http://127.0.0.1:4520
# Agent Maestro au nom duquel le client agit ; restreint le périmètre à ses
# collections RAG et ses outils maison. Absent : périmètre complet du jeton.
# MAESTRO_AGENT=Comptabilité

# --- Telegram (optionnel) ---
# Jeton du bot obtenu auprès de @BotFather. Jamais en dur dans le code ni en DB.
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Identifiants de chat autorisés, séparés par des virgules (whitelist stricte).
# TELEGRAM_CHAT_IDS=123456789

# --- Discord (optionnel) ---
# Jeton du bot (portail développeur Discord → Bot → Token).
# ⚠️ L'intent privilégié « Message Content » doit être activé sur la même page,
# sinon les messages arrivent sans texte et la passerelle semble sourde.
# DISCORD_BOT_TOKEN=...
# Salons autorisés, séparés par des virgules. Obligatoire : sans liste, la
# passerelle reste inactive — un bot qui répond partout exécute des agents pour
# n'importe qui.
# DISCORD_CHANNEL_IDS=123456789012345678

# --- Slack (optionnel, Socket Mode) ---
# Socket Mode, et non l'API Events : celle-ci exigerait une URL publique que
# Slack appelle. Ici c'est Maestro qui se connecte, donc rien à exposer.
# Jeton d'application (xapp-…), portée connections:write — ouvre la socket.
# SLACK_APP_TOKEN=xapp-...
# Jeton de bot (xoxb-…) — poste les messages. Les deux sont nécessaires.
# SLACK_BOT_TOKEN=xoxb-...
# Canaux autorisés, séparés par des virgules. Obligatoire, même raison.
# Le bot doit en être membre (/invite @maestro), sinon l'envoi est refusé.
# SLACK_CHANNEL_IDS=C0123456789

# --- RAG : embeddings (optionnel) ---
# Active la partie sémantique de la recherche RAG. Sans clé, la recherche reste
# lexicale (BM25) et fonctionne hors ligne. Le premier fournisseur configuré
# gagne. La clé n'est jamais stockée en base ni exposée à l'interface.
# VOYAGE_API_KEY=...
# OPENAI_API_KEY=...
